{
  "name": "dsh-learning-workbench",
  "version": "0.3.2",
  "description": "Learning workbench for DeepSeek Harness; skills implemented one feature at a time",
  "type": "module",
  "main": "./src/host.mjs",
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist/client.js",
    "dist/preview.html",
    "dist/skills",
    "dist/THIRD-PARTY-NOTICES.txt",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs",
    "test:ui": "node test/browser.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "playwright": "^1.56.1"
  }
}
